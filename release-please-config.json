{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "5781bf8c19b4631987850c316334b8150367a650",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "draft": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "viafrei-database",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Changed" },
        { "type": "refactor", "section": "Changed" },
        { "type": "revert", "section": "Removed" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "docs", "section": "Documentation", "hidden": false },
        { "type": "ci", "section": "Build and CI", "hidden": false },
        { "type": "build", "section": "Build and CI", "hidden": false },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true },
        { "type": "style", "section": "Chores", "hidden": true }
      ]
    }
  }
}
