{
  "name": "viafrei-database",
  "version": "0.1.0",
  "private": true,
  "description": "The ViaFrei schema and its changes: migrations, partitions, roles, a disposable database for tests, and the small service that applies them and reports on the database.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "viafrei-db": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "lint:migrations": "tsx src/cli.ts lint",
    "mutate": "tsx scripts/mutate.ts"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
