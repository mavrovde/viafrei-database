{
  "name": "viafrei-database",
  "version": "0.6.0",
  "private": true,
  "description": "The ViaFrei schema and its changes: migrations, partitions, roles, a disposable database for tests, and the small service that applies them and reports on the database.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "viafrei-db": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "coverage:shard": "vitest run --config vitest.coverage.config.ts --coverage --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0 --reporter=default --reporter=blob",
    "coverage:merge": "vitest run --config vitest.coverage.config.ts --coverage --merge-reports",
    "lint:migrations": "tsx src/cli.ts lint",
    "mutate": "tsx scripts/mutate.ts",
    "coverage:schema": "tsx scripts/coverage-schema.ts"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
